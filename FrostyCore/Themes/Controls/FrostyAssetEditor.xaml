<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Frosty.Core.Controls"
                    xmlns:controls="clr-namespace:Frosty.Controls;assembly=FrostyControls">
  <!-- FrostyAssetEditor -->
  <Style TargetType="{x:Type local:FrostyAssetEditor}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:FrostyAssetEditor}">
          <controls:FrostyDockablePanel Title="Properties"
                                    Icon="/FrostyEditor;component/Images/Properties.png">
            <local:FrostyPropertyGrid x:Name="PART_AssetPropertyGrid"
                                      Asset="{Binding Asset, RelativeSource={RelativeSource TemplatedParent}}"
                                      Modified="{Binding AssetModified, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
          </controls:FrostyDockablePanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>