<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="clr-namespace:Frosty.Controls">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/FrostyControls;component/Themes/Brushes.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <!-- FrostyEditableLabel -->
  <Style TargetType="{x:Type ctrl:FrostyEditableLabel}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ctrl:FrostyEditableLabel}">
          <StackPanel Orientation="Horizontal"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch">
            <TextBlock x:Name="PART_Label"
                       VerticalAlignment="Stretch"
                       Text="{Binding Path=Text, RelativeSource={RelativeSource FindAncestor, 
                    AncestorType={x:Type ctrl:FrostyEditableLabel}}, Mode=TwoWay}"
                       Foreground="{StaticResource FontColor}"
                       Margin="2,0,0,0" />
            <TextBox x:Name="PART_TextBox"
                     MinWidth="40"
                     Visibility="Collapsed"
                     VerticalAlignment="Stretch"
                     VerticalContentAlignment="Stretch"
                     Margin="2,0,10,0"
                     Cursor="IBeam" />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>