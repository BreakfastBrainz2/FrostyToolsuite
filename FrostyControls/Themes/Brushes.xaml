<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

  <SolidColorBrush x:Key="WindowBackground"
                   po:Freeze="True"
                   Color="#141414" />
  <SolidColorBrush x:Key="TitlebarBackground"
                   po:Freeze="True"
                   Color="#040404" />
  <SolidColorBrush x:Key="FontColor"
                   po:Freeze="True"
                   Color="#F8F8F8" />
  <SolidColorBrush x:Key="ControlBackground"
                   po:Freeze="True"
                   Color="#454545" />
  <SolidColorBrush x:Key="ControlHighlight"
                   po:Freeze="True"
                   Color="#707070" />
  <SolidColorBrush x:Key="ControlPressed"
                   po:Freeze="True"
                   Color="#585858" />
  <SolidColorBrush x:Key="ButtonImage"
                   po:Freeze="True"
                   Color="#292929" />
  <SolidColorBrush x:Key="ScrollbarBackground"
                   po:Freeze="True"
                   Color="#232323" />
  <SolidColorBrush x:Key="MenuItemHighlight"
                   po:Freeze="True"
                   Color="#6C6C6C" />
  <SolidColorBrush x:Key="MenuItemBackground"
                   po:Freeze="True"
                   Color="#141414" />
  <SolidColorBrush x:Key="SubMenuItemHighlight"
                   po:Freeze="True"
                   Color="#292929" />
  <SolidColorBrush x:Key="SubItemHighlight"
                   po:Freeze="True"
                   Color="#303030" />
  <SolidColorBrush x:Key="SubItemPressed"
                   po:Freeze="True"
                   Color="#404040" />
  <SolidColorBrush x:Key="ListBackground"
                   po:Freeze="True"
                   Color="#292929" />
</ResourceDictionary>